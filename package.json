    "canvas",
    "pixel-art",
    "retro-gaming"
  ],
  "author": "Space Invaders Classic Team",
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^8.57.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "game-logic.js"
    ],
    "testMatch": [
      "**/*.test.js"
    ]
  }
}