{
  "name": "space-invaders-classic",
  "version": "1.0.0",
  "description": "Classic 1980s Space Invaders game with pixel-perfect accuracy",
  "main": "space-invaders.html",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
